# RORSH SecureCom Server Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8443

# Admin Credentials (Single admin only)
ADMIN_ID=your_admin_id_here
ADMIN_PASSWORD=your_secure_password_here

# TLS Certificate Paths (optional - for self-hosted TLS)
# If not provided, server runs HTTP (use reverse proxy like Nginx/Render for HTTPS)
TLS_KEY_PATH=./certs/server.key
TLS_CERT_PATH=./certs/server.crt

# Logging
LOG_LEVEL=info
